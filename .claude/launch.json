{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Alexandria.Api", "--launch-profile", "http"],
      "port": 5130
    },
    {
      "name": "app-web",
      "runtimeExecutable": "npx",
